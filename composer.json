{
    "name": "juanchosl/apivirustotal",
    "description": "{}",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/JuanchoSL/apivirustotal",
    "minimum-stability": "dev",
    "keywords": [
        "log",
        "debug"
    ],
    "authors": [
        {
            "name": "Juan Sánchez Lecegui",
            "email": "Juan.Sanchez@tecnicosweb.com",
            "homepage": "https://www.linkedin.com/in/juansanchezlecegui/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "fig/http-message-util": "1.1.*",
        "psr/http-message": "^2.0",
        "psr/http-factory": "1.1.*",
        "psr/http-client": "1.0.*",
        "psr/log": "^3.0",
        "juanchosl/httpdata": "^1.0",
        "juanchosl/validators": "1.0.*@dev",
        "juanchosl/datamanipulation": "1.0.*@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "9.6.*",
        "phpstan/phpstan": "1.12.*",
        "juanchosl/curlclient": "dev-develop",
        "juanchosl/logger": "1.1.*"
    },
    "autoload": {
        "psr-4": {
            "JuanchoSL\\ApiVirusTotal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JuanchoSL\\ApiVirusTotal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "tests": "vendor/bin/phpunit --configuration phpunit.xml tests",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon"
    }
}
